:⏰ Scheduler chạy định kỳ (30 phút);

:📡 Bắt đầu crawl RSS từ VNExpress;

while (Còn RSS nào để crawl?) is (Có)
    
    :📥 Fetch RSS từ nguồn;
    
    if (Fetch RSS thành công?) then (Có)
        :🧹 Làm sạch HTML content;
        :📋 Thêm vào danh sách;
    else (Lỗi timeout/network)
        :📝 Log lỗi;
    endif
    
endwhile (Hết)

:📊 Tổng hợp tất cả bài báo từ nguồn;

while (Còn báo để phân tích?) is (Có)
    
    :🔍 Tạo cache key (title + link);
    
    if (Cache tồn tại?) then (Có)
        :📋 Lấy kết quả từ cache;
        note right
        **Cache Structure:**
        - cache_key: MD5 hash
        - analysis_result: JSON
        - created_at: timestamp
        - expires_at: 24h later
        end note
    else (Không)
        :⚡ Kiểm tra rate limiting (1s);
        
        :🤖 Gọi Gemini AI phân tích;
        note right
        **Gemini Analysis:**
        Input: title + URL
        Output: {
          "is_positive": boolean,
          "summary": "2-3 câu tóm tắt",
          "sentiment_score": 0.0-1.0,
          "keywords": ["array"],
          "reasoning": "lý do phân tích"
        }
        end note
        
        if (AI call thành công?) then (Có)
            :💾 Lưu kết quả vào cache;
        else (Lỗi API/Network)
            if (API Limit?) then (Có)
                :⏸️ Tạm dừng crawl cycle;
                stop
            else (Network error)
                :📝 Log lỗi, bỏ qua article;
            endif
        endif
    endif
    
    if (Tin tức tích cực?) then (is_positive = true)
        :🔄 Transform sang Firebase schema;
        note right
        **Firebase Schema (8 fields):**
        - title: string
        - link: string  
        - summary: string
        - image_url: string
        - published: timestamp
        - sentiment_score: float
        - keywords: array
        - reasoning: string
        end note
        
        :🔍 Kiểm tra trùng lặp bài báo;
        
        if (Bài báo đã tồn tại?) then (Không)
            :💾 Lưu vào Firebase collection;
            
            if (Lưu Firebase thành công?) then (Có)
                :✅ Tăng counter success;
            else (Lỗi Firebase)
                :🔄 Retry 3 lần với backoff;
                
                if (Retry thành công?) then (Có)
                    :✅ Tăng counter success;
                else (Vẫn lỗi)
                    :❌ Log lỗi Firebase;
                endif
            endif
        else (Đã tồn tại)
            :📋 Log: Article already exists;
        endif
        
    else (is_positive = false)
        :❌ Bỏ qua tin tiêu cực;
    endif
    
endwhile (Hết)

:📊 Tính toán và log thống kê;
note right
**Statistics:**
- Tổng articles crawled
- Số tin tích cực found  
- Số tin stored thành công
- Cache hit rate
- API calls made
- Error count
end note

:🧹 Cleanup memory cache;

:💤 Sleep đến chu kỳ tiếp theo (30 phút);

stop

@enduml

' Thuật toán Safe News Crawler tự động thu thập và phân tích tin tức tích cực từ các nguồn RSS uy tín. Hệ thống hoạt động theo chu kỳ 30 phút, crawl từ 4 nguồn RSS (VnExpress, TienPhong, TuoiTre, Dantri) với focus vào các chuyên mục tích cực như giáo dục, sức khỏe, gia đình. Sử dụng Gemini AI để phân tích và lọc chỉ những tin tức có sentiment tích cực, sau đó transform sang Firebase schema chuẩn và lưu trữ với duplicate detection. Hệ thống tối ưu hiệu suất với cache in-memory, rate limiting cho API calls, và error handling thông minh cho các tình huống như RSS timeout, API limit, hoặc Firebase connection issues. Monitoring đầy đủ với structured logging và statistics tracking đảm bảo hệ thống vận hành ổn định và có thể scale trong tương lai.
